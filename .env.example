# Copy to .env and fill in. Any OpenAI-compatible chat-completions endpoint works.
# Prompts reach about 8k tokens (roughly 20,000 characters), and a full four-system run makes 12 to 25 calls.

# Azure AI Foundry / Azure OpenAI (v1 API). LLM_MODEL is your deployment name.
LLM_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
LLM_API_KEY=your-key
LLM_MODEL=your-deployment-name

# Google Gemini (OpenAI-compatible endpoint). Key from https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=a-current-gemini-model-id

# Local model with Ollama. Raise the model's context window to at least 16k first.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=your-local-model

# API key of the mock EHR (only a mock; change it to see that it never reaches a prompt or adapter)
# EHR_API_KEY=demo-key
