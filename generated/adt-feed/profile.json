 "data_quality_notes": [
  "All message and encounter timestamps (MSH.7, EVN.2, PV1.44, PV1.45) lack timezone offsets (YYYYMMDDHHMMSS format).",
  "PV1.45 (Discharge Date/Time) is absent in 15 of 176 records, corresponding to active admissions or outpatient registrations.",
  "File extension is .qd6 in discovery output example while system metadata pattern is *.hl7, requiring confirmation of actual file naming convention."
 ],
 "open_questions": [
  "Should integration assume Europe/Dublin timezone for all naive timestamps based on Country Code 'IE' in PID.11.6?",
  "Will files be consumed via real-time directory polling (e.g. MLLP vs file watcher), and should processed files be deleted or moved?",
  "What is the expected file naming convention (.hl7 vs .qd6 extension)?",
  "Is there a mechanism to handle out-of-order ADT messages if files are written concurrently?"
 ]
